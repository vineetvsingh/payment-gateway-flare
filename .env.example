PORT=3000
# The site's public address; used to build donation, checkout and overlay links. Online: https://your-domain
BASE_URL=http://localhost:3000
# Behind a hosting provider's load balancer, set to 1 so rate limits see real visitor IPs and
# login cookies are marked Secure.
TRUST_PROXY=
DB_PATH=gateway.db
# closed: only the first account can sign up (yours). Use it online so strangers can't make pages on your site.
SIGNUPS=open
# Where OBS and the voice tab load alerts from, if not BASE_URL. Behind ngrok, set http://localhost:3000:
# OBS can't click through ngrok's warning page, and local links keep working if the tunnel drops.
OVERLAY_BASE_URL=
# 32-byte hex key that encrypts saved Razorpay keys (and test-mode card numbers). Keep it forever. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY=
# Test mode: donations become available for payout after this many seconds (default: 2 days).
SETTLEMENT_DELAY_SECONDS=172800
# Test mode: UPI requests expire if the payer doesn't approve within this many seconds.
UPI_EXPIRY_SECONDS=300
# How often to ask Razorpay about unfinished payments and pending refunds (ms).
PROVIDER_SYNC_INTERVAL_MS=30000

# Your own Razorpay keys (Razorpay Dashboard -> API Keys). Both `npm start` and `npm run demo` connect
# them to your account, so donations to your page go through Razorpay. Keep this file out of git
# (.gitignore already does). Any other account connects Razorpay from its own dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The page name of the account those keys belong to. Leave empty when the site has only your account.
CHANNEL_HANDLE=
