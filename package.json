{
  "name": "stream-donations",
  "version": "0.1.0",
  "private": true,
  "description": "Donations for live streamers, with on-stream alerts read aloud, on a small payment gateway (test-mode simulator or Razorpay).",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx examples/demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
